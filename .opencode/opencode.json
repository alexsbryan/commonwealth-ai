{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/sovereign-atos.ts"
  ],
  "mcp": {
    "sovereign": {
      "type": "remote",
      "url": "http://localhost:9741/mcp"
    }
  },
  "provider": {
    "commonwealth": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Commonwealth Mesh",
      "options": {
        "baseURL": "http://localhost:9741/v1"
      },
      "models": {
        "auto": {
          "name": "Commonwealth (auto-routed)"
        }
      }
    }
  }
}