[Unit]
Description=Commonwealth Daemon - Distributed Inference and Knowledge Coordination
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/commonwealth daemon start
ExecStop=/usr/local/bin/commonwealth daemon stop
Restart=on-failure
RestartSec=10
User=commonwealth
Group=commonwealth
WorkingDirectory=/var/lib/commonwealth

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=commonwealth

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/commonwealth
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
