[Unit]
# The daemon owns the GGUFs. It is the ONLY process that loads model
# weights; sovereign-server delegates inference to it over loopback via a
# `type = "remote"` backend, so the weights are paid for once. Running
# both with embedded engines would double VRAM and neither would fit.
Description=firm-rag inference daemon (svrnmesh) — owns the model weights
Documentation=file:/opt/firm-rag/README.md
After=network.target
# NOT network-online.target: this box makes no outbound connections (see
# EGRESS.md). Waiting on a route it never uses only slows boot.

# A daemon that dies instantly on every start (bad config, missing GGUF,
# held port) must not relaunch forever. Five failures in ten minutes and
# it stays down until someone looks:
#   systemctl reset-failed firm-rag-daemon
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=firmrag
Group=firmrag

# `daemon run` runs in the foreground. `daemon start` DETACHES and would
# make systemd think the service exited immediately — the single most
# common way to get this unit wrong.
#
# `--config` is passed explicitly rather than relying on the canonical
# `$HOME/.svrnmesh/config.toml`: that path is resolved through the
# rebrand layer (~/.svrnmesh, falling back to a populated ~/.svrnmesh),
# which under a service user is both fragile and invisible from this
# file. With --config the operator owns the path, and the first-boot
# wizard is skipped — a missing file becomes a clean error instead of a
# daemon waiting on a TTY that will never arrive.
ExecStart=/opt/firm-rag/bin/svrn daemon run --config /etc/firm-rag/daemon-config.toml

WorkingDirectory=/var/lib/firm-rag
# HOME is set so that any home-derived fallback path inside the process
# lands somewhere writable instead of resolving to "." (which, with
# ProtectSystem=strict and WorkingDirectory unset, would be an
# unwritable /). The daemon's own data root is NOT taken from here — it
# comes from `[data] dir` in the config, which does not read
# SOVEREIGN_DATA_DIR. Keep the three in agreement by hand.
Environment=HOME=/var/lib/firm-rag
Environment=SOVEREIGN_DATA_DIR=/var/lib/firm-rag
# OCR assets, staged by install.sh. Both are required on an air-gapped
# box: paddle::models_root()'s built-in fallback is a hardcoded
# ~/.svrnmesh path that a service user never has, and there is no system
# libpdfium to fall back to — without which no PDF can be rasterized and
# OCR silently yields nothing. See docs/ENV_FLAGS.md.
Environment=SOVEREIGN_PADDLE_OCR_MODEL_DIR=/var/lib/firm-rag/models/paddle-ocr
Environment=SOVEREIGN_PDFIUM_LIB=/var/lib/firm-rag/lib/libpdfium.so

# Do NOT set SOVEREIGN_SKIP_VRAM_CHECK here. It bypasses the whole
# preflight INCLUDING the unreadable-file refusal, which is exactly the
# check that catches a model that failed to copy during install. The VRAM
# gate is advisory by default: it warns on overcommit and starts anyway.

Restart=on-failure
RestartSec=10
# Graceful drain (axum drain + mesh.json persist) is well under 30s. Past
# that the daemon is wedged and SIGKILL is the right answer.
TimeoutStopSec=30

# ── Sandbox ──────────────────────────────────────────────────────────
# ProtectSystem=strict makes the entire filesystem read-only except what
# is named below. The daemon needs: its data dir, and read access to the
# firm's document share.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
# ^ `no`, not `yes`: GPU offload needs /dev/dri (or /dev/nvidia*). With
#   PrivateDevices=yes the daemon starts, finds no GPU, and runs on CPU —
#   a 20x slowdown that looks like "the model is just slow" rather than a
#   misconfiguration. If this box is CPU-only, set it to yes.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

# ── Egress: denied by the kernel, not by configuration ───────────────
# The config in /etc/firm-rag/daemon-config.toml switches off the
# Wikipedia freshness poller, iroh/n0 relays, n0 DNS, and mDNS. This
# enforces that independently of whether those keys are correct, whether
# a future upgrade changes a default, or whether a key was silently
# dropped — which this schema does without warning, since it sets no
# `deny_unknown_fields`.
#
# The daemon's MCP surface still registers `wikipedia_fetch`, which has
# no cargo feature to remove it (unlike the server's). This line is the
# control for it. See EGRESS.md §1.
#
# Loopback only: the daemon serves :9741 to sovereign-server and binds
# :9742 to 127.0.0.1. It has no peers.
IPAddressDeny=any
IPAddressAllow=localhost

ReadWritePaths=/var/lib/firm-rag
# The config holds no secrets (the client token is auto-generated under
# the data dir) but it is the deployment contract — read-only so a
# compromised process cannot rewrite its own binds.
ReadOnlyPaths=/etc/firm-rag
# The mounted share holding the firm's documents. Read-only: this system
# indexes their files, it never writes to them. Adjust the path to match
# the real mount, and keep it read-only — a RAG box with write access to
# a document share is a much larger conversation with their IT.
ReadOnlyPaths=/srv/firm-docs

# No MemoryMax on purpose: a cgroup limit SIGKILLs with no drain. The
# daemon's own memory watch self-SIGTERMs (exit 102) and lets
# Restart=on-failure relaunch it cleanly. Set SOVEREIGN_RSS_SOFT_LIMIT_MB
# / SOVEREIGN_RSS_HARD_LIMIT_MB if you need a ceiling.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=firm-rag-daemon

[Install]
WantedBy=multi-user.target
