/target
/models
/data
*.gguf
*node_modules
dist*

# Desktop OCR binaries — populated by scripts/fetch-desktop-binaries.sh.
# Large blobs, per-target, not source. README at the path explains how
# to repopulate. The README itself stays tracked.
crates/sovereign-desktop/src-tauri/binaries/tesseract-*
crates/sovereign-desktop/src-tauri/binaries/pdfium/
crates/sovereign-desktop/src-tauri/binaries/tessdata/

# Sovereign code intelligence
.sovereign/project.json
.sovereign/scip/
# SQLite databases (notes.db, features.db, mesh.db, …) — personal
# session state, binary, not for source control. Glob covers the db
# file itself plus its -shm / -wal / -journal sidecars in one rule so
# new dbs are caught automatically.
.sovereign/*.db
.sovereign/*.db-*

# Bench data artifacts — regenerable from scripts in the same dir, too
# large or session-specific to source-control. Scaffolding (README.md,
# input .toml fixtures, run scripts) stays tracked; the campaign-level
# findings are consolidated into bench/HISTORY.md. Only raw produced
# data is ignored.
bench/atlas_retrieval/chunks-*.jsonl
bench/atlas_retrieval/bench-results-*.json
bench/atlas_retrieval/bench-report-*.md
bench/atlas_retrieval/brief-quality-*
bench/atlas_retrieval/regression-*.jsonl
bench/atlas_retrieval/regression-*.md
bench/atlas_retrieval/embedding-comparison.md
bench/atlas_retrieval/golden-gt-*.jsonl
bench/atlas_throughput/run-*.json
bench/atlas_throughput/run-*.log
bench/sep_atlas/logs/
bench/sep_eval/
bench/voice/baseline/*.json
bench/voice/baseline/*.txt
bench/voice/baseline/*.md
bench/voice/baseline/diff-*.txt

# Playwright artifacts (chat surface e2e tests).
crates/sovereign-desktop/test-results/
crates/sovereign-desktop/playwright-report/
crates/sovereign-desktop/playwright/.cache/

# TTFI harness reports — local artifacts, regenerable via `npm run test:ttfi`.
crates/sovereign-desktop/tests/e2e/.ttfi-report.json
crates/sovereign-desktop/tests/e2e/.ttfi-baseline.json
