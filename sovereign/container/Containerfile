# sovereign-mesh worker container, ROCm flavor.
#
# Builds an image that joins your tailnet, pulls Darwin GGUFs from R2,
# and runs `sovereign-cli daemon run` with the mesh advertising
# whatever slots fit on the host GPU. Designed for ad-hoc spin-up on
# RunPod MI300X (gfx942) instances; same image with AMDGPU_TARGETS
# adjusted works on MI250X (gfx90a) or MI100 (gfx908).
#
# ── build (from commonwealth-ai/ workspace root, NOT from sovereign/):
#     cd ~/dev/commonwealth-ai
#     podman build -t ghcr.io/<you>/sovereign-rocm:latest \
#                  -f sovereign/container/Containerfile .
#
# `podman` is the recommended builder on Fedora / RHEL / Toolbox
# hosts (rootless, daemonless). `docker build -f Containerfile` works
# identically — both consume Dockerfile syntax and emit OCI-compliant
# images that any registry (ghcr, Docker Hub, RunPod) accepts.
#
# The build context is the commonwealth-ai/ monorepo root because the
# workspace Cargo.toml at that root declares every crate (corpus-engine,
# oicp-types, commonwealth/crates/*, sovereign/crates/*) as a path-dep
# member. Building from sovereign/ alone would not see those manifests.
#
# ── run locally (rootful podman, AMD GPU passthrough):
#     podman run --rm \
#       --device=/dev/kfd --device=/dev/dri --group-add video \
#       -e TS_AUTHKEY=tskey-... \
#       -e MESH_SEED_ADDR=100.x.y.z:9742 \
#       -e R2_ENDPOINT=... -e R2_ACCESS_KEY=... -e R2_SECRET_KEY=... \
#       -e PRIMARY_COPIES=1 \
#       -p 9741:9741 -p 9742:9742 \
#       ghcr.io/<you>/sovereign-rocm:latest
#
# (RunPod's runtime adds GPU device passthrough automatically; the
# --device / --group-add flags above are only needed for direct
# rootful local runs.)

# ─── Build stage ─────────────────────────────────────────────────────
FROM docker.io/rocm/dev-ubuntu-22.04:7.2 AS build

ENV DEBIAN_FRONTEND=noninteractive
# Build-chain peer deps for the Cargo workspace:
#   protobuf-compiler  — lance-encoding / prost-build need `protoc`
#   clang / libclang   — bindgen (llama-cpp-rs, ring, etc.)
#   python3            — invoked by some build scripts (llama.cpp helpers)
#   hipblas-dev /
#   rocblas-dev        — math libs llama.cpp's GGML_HIP=ON needs at
#                        link time. The rocm/dev-ubuntu-22.04 base
#                        image ships the HIP runtime but NOT these.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git curl ca-certificates pkg-config libssl-dev \
      protobuf-compiler libprotobuf-dev \
      clang libclang-dev llvm-dev python3 \
      hipblas-dev rocblas-dev \
 && rm -rf /var/lib/apt/lists/*

# Where prost-build / lance-* find the well-known google/protobuf/*.proto
# imports. `libprotobuf-dev` installs them under /usr/include.
ENV PROTOC=/usr/bin/protoc
ENV PROTOC_INCLUDE=/usr/include

# Rust toolchain. `rustfmt` is required: llama-cpp-sys-2's bindgen
# pipes its generated bindings through `rustfmt`; without it the build
# errors with `'rustfmt' is not installed for the toolchain`.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable \
 && /root/.cargo/bin/rustup component add rustfmt
ENV PATH="/root/.cargo/bin:${PATH}"

# ROCm/HIP env. Two subtleties here:
#
# 1. cmake-rs (the build-script crate llama-cpp-sys-2 uses) explicitly
#    sets `CMAKE_PREFIX_PATH=""` in its cmake invocation, which clobbers
#    whatever we put in this image's env. So we use `<Package>_ROOT`
#    env vars instead — CMake 3.12+ honors these for find_package()
#    and cmake-rs leaves them alone.
# 2. `AMDGPU_TARGETS` picks the GPU ISA at compile time. Default
#    gfx942 = MI300X. Override at build time for other AMD parts:
#        --build-arg AMDGPU_TARGETS=gfx90a   # MI250X
#        --build-arg AMDGPU_TARGETS=gfx908   # MI100
ARG AMDGPU_TARGETS=gfx942
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm
ENV PATH=/opt/rocm/bin:${PATH}
ENV AMDGPU_TARGETS=${AMDGPU_TARGETS}
ENV GPU_TARGETS=${AMDGPU_TARGETS}
# CMake find_package(<Pkg>) honors <Pkg>_ROOT env. Point at /opt/rocm
# so llama.cpp's ggml-hip CMakeLists locates each math-lib's config
# file (hipblas-config.cmake etc. under /opt/rocm/lib/cmake/<pkg>/).
ENV hip_ROOT=/opt/rocm
ENV hipblas_ROOT=/opt/rocm
ENV rocblas_ROOT=/opt/rocm
ENV hipblaslt_ROOT=/opt/rocm

# ggml-hip's static archive uses 32-bit absolute relocations
# (`R_X86_64_32`), which the default linux x86_64 PIE link rejects with
# "recompile with -fPIC". Drop PIE for this binary — analogous to the
# `-lnccl` link-arg in Containerfile.cuda.
ENV RUSTFLAGS="-C link-arg=-no-pie"

# Build context = commonwealth-ai/ workspace root. Post-monorepo (May
# 2026) the single workspace Cargo.toml + Cargo.lock live here; each
# of corpus-engine/, oicp-types/, commonwealth/, sovereign/ contains
# workspace-member crates referenced by path from the root manifest.
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY commonwealth/        ./commonwealth/
COPY corpus-engine/       ./corpus-engine/
COPY oicp-types/          ./oicp-types/
# corpus-engine/build.rs reads bundled `vital_articles_*.txt` from
# the sibling `sovereign-recipes/` repo; without these the build
# panics. We copy only the data subtree the build script reads to
# keep the build context lean (sovereign-recipes is ~600 MB total,
# mostly unrelated corpora data).
COPY sovereign-recipes/wikipedia/data/   ./sovereign-recipes/wikipedia/data/
# Only copy the parts of sovereign/ that cargo actually needs. Skipping
# container/, scripts/, docs/, bench/, etc. means edits to those don't
# invalidate the cargo-build layer (which is the slow one). Workspace
# members all live under crates/, but a few sovereign-rooted files are
# pulled in via `include_str!` at compile time and must be present:
#   - sovereign/models.toml              → sovereign-core::models_manifest
#   - sovereign/contrib/{launchd,systemd}/ → sovereign-cli::service_install
#   - sovereign/.opencode/               → sovereign-cli::doctor_cmd
COPY sovereign/models.toml ./sovereign/models.toml
COPY sovereign/crates/    ./sovereign/crates/
COPY sovereign/contrib/   ./sovereign/contrib/
COPY sovereign/.opencode/ ./sovereign/.opencode/

RUN cargo build --release --bin sovereign-cli

# ─── Runtime stage ───────────────────────────────────────────────────
FROM docker.io/rocm/dev-ubuntu-22.04:7.2

ENV DEBIAN_FRONTEND=noninteractive
# Runtime math libs (hipblas, rocblas) — the binary dlopen's these on
# slot load; without them the daemon segfaults when llama.cpp tries to
# init a ROCm device. iproute2/iptables are required by tailscaled's
# userspace networking mode.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates iproute2 iptables unzip \
    hipblas rocblas \
    libgomp1 \
 && curl -fsSL https://tailscale.com/install.sh | sh \
 && curl -fsSL https://rclone.org/install.sh | bash \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /workspace/target/release/sovereign-cli /usr/local/bin/sovereign-cli

# Workspace volume — RunPod mounts /workspace by default; our entrypoint
# arranges /workspace/models for GGUFs and /workspace/data for atlases.
WORKDIR /workspace
RUN mkdir -p /workspace/models /workspace/data /root/.config/sovereign /root/.config/rclone

COPY sovereign/container/entrypoint.sh           /entrypoint.sh
COPY sovereign/container/entrypoint-tailscale.sh /entrypoint-tailscale.sh
RUN chmod +x /entrypoint.sh /entrypoint-tailscale.sh

# Daemon's external HTTP + internal mesh gossip ports.
EXPOSE 9741 9742

ENV SOVEREIGN_DATA_DIR=/workspace/data
ENV SOVEREIGN_MODELS_DIR=/workspace/models
ENV PRIMARY_COPIES=1
ENV CONTEXT_SIZE=32768

ENTRYPOINT ["/entrypoint.sh"]
