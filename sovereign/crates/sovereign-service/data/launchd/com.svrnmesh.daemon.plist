<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    svrnmesh user daemon — launched by launchd on login.

    {BINARY} is substituted by service_install.rs with the absolute path
    to the sovereign binary at install time. {HOME} is substituted with
    the user's home directory so logs and working dir are per-user.

    Install:  svrn setup
    Stop:     svrn daemon stop
    Restart:  svrn daemon restart
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.svrnmesh.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>{BINARY}</string>
        <string>daemon</string>
        <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Auto-restart if the daemon exits with a non-zero status (crash).
         The daemon's own memory watch (RAM-derived limits, default ON —
         DAEMON_RESILIENCE.md P0.3) exits 102 on RSS-hard-limit breach to
         request exactly this relaunch. launchd's default ThrottleInterval
         (10s) spaces respawns; there is no StartLimitBurst equivalent, so
         a boot-crashing daemon relaunches every ~10s until unloaded. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- SIGKILL grace after SIGTERM at unload: graceful drain takes well
         under 30s; past that the daemon is wedged. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>{DATA_DIR}/logs/daemon.log</string>

    <key>StandardErrorPath</key>
    <string>{DATA_DIR}/logs/daemon.err</string>

    <key>WorkingDirectory</key>
    <string>{DATA_DIR}</string>

    <!-- Environment: {PATH} is the PATH of the shell that ran
         `install-service` — the one environment where the operator's
         toolchain is known to resolve. Launchd's own minimal PATH silently
         severed the SCIP exporters (rust-analyzer et al): every git_poll
         reindex exported 0 symbols and the graph froze at its last indexed
         commit (live incident 2026-08-06). Capturing the install-time PATH
         works for any toolchain manager; a relocated toolchain needs
         `install-service` re-run. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{PATH}</string>
    </dict>
</dict>
</plist>
