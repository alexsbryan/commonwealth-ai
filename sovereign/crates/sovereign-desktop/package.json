{
  "name": "sovereign-desktop",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "meshapp:catalog": "node scripts/gen-meshapp-catalog.mjs",
    "predev": "npm run meshapp:catalog",
    "dev": "vite dev",
    "screens": "vite dev --open /screens.html",
    "prebuild": "npm run meshapp:catalog",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:loose": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "test:e2e:faults": "playwright test -c playwright.faults.config.ts",
    "sabotage": "node tests/e2e/scripts/sabotage.mjs",
    "sabotage:list": "node tests/e2e/scripts/sabotage.mjs --list",
    "demo": "playwright test -c playwright.demo.config.ts",
    "demo:export": "node tests/e2e/scripts/demo-export.mjs",
    "test:journeys": "playwright test -c playwright.real.config.ts tests/e2e/real/journeys/",
    "a11y": "node tests/e2e/scripts/a11y-report.mjs",
    "soak": "node tests/e2e/scripts/soak.mjs",
    "breaker": "node tests/e2e/scripts/soak.mjs --breaker",
    "chaos": "node tests/e2e/scripts/chaos.mjs",
    "report:soak": "node tests/e2e/scripts/soak-report.mjs",
    "report:breaker": "node tests/e2e/scripts/breaker-report.mjs",
    "report:journeys": "node tests/e2e/scripts/journey-report.mjs",
    "report:coverage:real": "node tests/e2e/scripts/coverage-report.mjs test-artifacts/ledger-synthetic.jsonl test-artifacts/ledger-real.jsonl",
    "test:ttfi": "playwright test specs/ttfi.spec.ts",
    "report:ttfi": "node tests/e2e/scripts/ttfi-summary.mjs",
    "report:coverage": "node tests/e2e/scripts/coverage-report.mjs",
    "report:ttfi:save-baseline": "cp tests/e2e/.ttfi-report.json tests/e2e/.ttfi-baseline.json"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "@tauri-apps/plugin-shell": "~2.3.0",
    "@xstate/svelte": "^5.0.0",
    "highlight.js": "^11.11.1",
    "immer": "^11.1.4",
    "katex": "^0.16.47",
    "marked": "^15.0.12",
    "marked-katex-extension": "^5.1.8",
    "qrcode": "^1.5.4",
    "xstate": "^5.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsdom": "^26.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
