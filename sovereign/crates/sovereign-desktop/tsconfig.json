{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    // Shared chat render surface, consumed as source via this path
    // alias. Mirrored in vite.config.ts + vitest.config.ts.
    "baseUrl": ".",
    "paths": {
      "@sovereign/chat-ui": ["../../../packages/chat-ui/src/index.ts"]
    },
    // `skipLibCheck` skips type checking of declaration files under
    // node_modules. Without it, Vitest's transitive `.d.ts` files
    // reference Node globals (`NodeJS.*`, `node:worker_threads`) that
    // our browser-targeted tsconfig doesn't know about, and
    // `svelte-check` reports 50+ phantom errors on them.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
