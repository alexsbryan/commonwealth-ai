{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-schema/main/src/tauri-conf.schema.json",
  "bundle": {
    "externalBin": [
      "binaries/tesseract"
    ],
    "resources": [
      "binaries/tessdata/*",
      "binaries/pdfium/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libvulkan1"]
      },
      "rpm": {
        "depends": ["vulkan-loader"]
      }
    }
  }
}
