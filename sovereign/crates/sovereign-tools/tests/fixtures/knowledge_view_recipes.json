  "conversation": {
    "corpus": {
      "id": "conversation-history",
      "name": "Conversation history",
      "description": "Enriched perspective on the conversations + messages tables (180-day window): recurring topics, unresolved threads, cross-session connections.",
      "license": "local-only",
      "mesh_sharing": false,
      "scope": "local",
      "query_sharing": false,
      "grantable": false,
      "size_compressed_gb": 0.0,
      "size_indexed_gb": 0.0,
      "schema_version": 1,
      "kind": "knowledge",
      "on_demand": false,
      "parent_corpus_id": null
    },
    "acquire": {
      "type": "custom",
      "kind": "sqlite",
      "params": {
        "db_path": "/fixture/sovereign.db",
        "query": "SELECT c.id   AS conversation_id, c.updated_at AS version, ( '### [' || strftime('%Y-%m-%d %H:%M', m.created_at, 'unixepoch') || '] ' || m.role || char(10) || m.content ) AS content FROM conversations c JOIN messages m ON m.conversation_id = c.id WHERE c.deleted_at IS NULL AND c.updated_at > (strftime('%s','now') - 180*86400) ORDER BY c.updated_at DESC, m.created_at ASC",
        "content_column": "content",
        "id_column": "conversation_id",
        "version_column": "version",
        "group_column": "conversation_id",
        "group_separator": "\n\n"
      }
    },
    "extract": {
      "type": "jsonl",
      "content_field": "content",
      "title_field": null,
      "filter": null,
      "decompress": null
    },
    "chunk": {
      "type": "threaded_turns"
    },
    "index": {
