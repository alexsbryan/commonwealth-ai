<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    svrnmesh user daemon — launched by launchd on login.

    {BINARY} is substituted by service_install.rs with the absolute path
    to the sovereign binary at install time. {HOME} is substituted with
    the user's home directory so logs and working dir are per-user.

    Install:  svrn setup
    Stop:     svrn daemon stop
    Restart:  svrn daemon restart
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.svrnmesh.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>{BINARY}</string>
        <string>daemon</string>
        <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Auto-restart if the daemon exits with a non-zero status (crash). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>{DATA_DIR}/logs/daemon.log</string>

    <key>StandardErrorPath</key>
    <string>{DATA_DIR}/logs/daemon.err</string>

    <key>WorkingDirectory</key>
    <string>{DATA_DIR}</string>

    <!-- Environment: keep PATH usable so child processes (e.g. llama-server
         if the embedded inference falls back to spawning one) can find the
         system binaries. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
