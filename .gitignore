# commonwealth-ai workspace shell — tracks the cross-cutting tooling
# (lint/test scripts, watcher config, agent contract). Each sub-repo
# below is a separate git remote and is cloned into place by
# `bootstrap.sh` on a fresh workstation.

# ── Sub-repos: tracked independently ──────────────────────────────────────

# ── Build artefacts ───────────────────────────────────────────────────────
/target/

# Local desktop-release container rehearsal (scripts/build-desktop-linux.sh):
# isolated cargo/npm caches + a separate CARGO_TARGET_DIR so container
# compiles don't stomp the host's target/. All regenerable build output.
/target-container-linux/
/.cargo-container/
/.npm-container/
/.npm-container-modules/
/.tauri-cache-container/

# Windows containerized cross-build (scripts/build-desktop-windows.sh):
# same isolation pattern, plus cargo-xwin's MSVC CRT/SDK download cache.
/target-container-windows/
/.cargo-container-windows/
/.npm-container-modules-windows/
/.xwin-container/
/.ort-cache-container/

# Windows cross-compile gate (scripts/windows-crosscheck.sh) uses a separate
# CARGO_TARGET_DIR so the windows-msvc build doesn't stomp the host target/.
# Unanchored so it's ignored wherever it lands. All regenerable build output.
target-xwin/

# ── Per-host runtime state ────────────────────────────────────────────────
# .sovereign/sovereign.toml is workspace config (tracked); every other
# entry in .sovereign/ is per-host bookkeeping or alignment-corpus
# territory and must NOT sync via this repo.
#
# SQLite databases + their sidecar files (-shm, -wal, -journal) are
# per-host runtime state. Match them generically so a new db (mesh.db,
# atos.db, …) doesn't silently sneak into a commit before someone
# remembers to add an explicit rule.
**/.sovereign/*.db
**/.sovereign/*.db-*
.sovereign/features/
.sovereign/atos-demo/
.sovereign/project.json
.sovereign/.lock

# ── Agent runtime state ───────────────────────────────────────────────────
# CLAUDE.md / settings.json / hooks/ are tracked. Everything below is
# session-local: plans, scheduled-task locks, machine-specific overrides.
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/projects/
.claude/plans/
.claude/cache/

# ── Opencode editor ───────────────────────────────────────────────────────
# config + plugin manifest tracked; node_modules is per-host.
.opencode/node_modules/

# ── Internal handoff/investigation notes (kept locally, not published) ────
# Ephemeral dev-process notes (HANDOFF*.md, RPC_*_HANDOFF, *_INVESTIGATION).
# Relocated here for the open-source launch so they stay on the author's box
# but never ship to the public repo. Already-tracked copies removed in the
# same commit.
docs/internal/

# ── Personal corpora/benches (kept local, never published) ────────────────
# Untracked for the open-source launch: the Obsidian-vault bench answer-keys
# (distilled from the author's private essays) and the `alignment` recipe
# (syncs the author's ~/.claude plans/memory). The CLI verbs that use them
# stay in the tree; they no-op without this local data.
sovereign/bench/obsidian/
sovereign-recipes/alignment/

# ── macOS noise ───────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
*/.DS_Store

models/

# ── Generated dev/analysis artifacts (never commit) ───────────────────────
# Drift reports + their archaeology/rough sidecars and the agent-bench report
# are regenerated on demand by the developer toolchain — large, machine-
# specific, and not part of the source. Removed from the tree for the
# open-source launch (2026-06-08).
/drift_report_*
/*.archaeology.json
/*.rough.json
/agent-bench-report.json

# ── Python bytecode cache (never commit) ──────────────────────────────────
# Regenerable compiled bytecode from the dev probe scripts + agent-coding
# bench scaffolds. A stale .pyc even leaked a home-dir path once (it embeds
# the absolute source path at compile time). Match at any depth.
__pycache__/
*.pyc
*.pyo

# ── Mesh-soak run artefacts (regenerated by scripts/mesh-soak.sh) ──────────
/mesh-soak-findings.jsonl
/mesh-soak-baseline.json
/mesh-soak-repro/
# Inner-chaos / bench run outputs (ephemeral) — at repo root or under any
# sub-repo (e.g. sovereign/test-artifacts/ when a harness runs with CWD there).
test-artifacts/
# Generated research/bench artifacts — keep source scripts, ignore heavy outputs
research/**/out/
research/**/out-v2/
*.npz


dist/