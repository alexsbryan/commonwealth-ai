# syntax=docker/dockerfile:1.7
# sovereign ephemeral-worker container, ROCm flavor.
#
# Builds an image that runs `sovereign-cli daemon run --worker-mode`.
# The pod becomes a single-owner ephemeral worker — see
# svrn/docs/EPHEMERAL_WORKER_PODS.md. No Tailscale, no R2, no
# mesh gossip; the owner connects directly to :9742 over a
# seed-derived TLS pin.
#
# ── build (from the commonwealth-ai/ workspace root, NOT from serve/):
#     cd ~/dev/commonwealth-ai
#     podman build -t ghcr.io/<you>/sovereign-rocm:latest \
#                  -f serve/container/Containerfile .
#
# `podman` is the recommended builder on Fedora / RHEL / Toolbox
# hosts (rootless, daemonless). `docker build -f Containerfile` works
# identically.
#
# The build context is the commonwealth-ai/ monorepo root because the
# workspace Cargo.toml at that root declares every crate as a
# path-dep member.
#
# ── run locally (rootful podman, AMD GPU passthrough):
#     podman run --rm \
#       --device=/dev/kfd --device=/dev/dri --group-add video \
#       -e SOVEREIGN_BOOTSTRAP="$(sovereign worker-pod mint-blob …)" \
#       -p 9742:9742 \
#       ghcr.io/<you>/sovereign-rocm:latest
#
# In production the owner doesn't run the pod locally — Vast/RunPod
# does, and the owner ships `SOVEREIGN_BOOTSTRAP` via the provider's
# onstart-cmd env. (RunPod's runtime adds GPU device passthrough
# automatically; the --device / --group-add flags above are only
# needed for direct rootful local runs.)

# ─── Build stage ─────────────────────────────────────────────────────
FROM docker.io/rocm/dev-ubuntu-22.04:7.2 AS build

ENV DEBIAN_FRONTEND=noninteractive
# Build-chain peer deps for the Cargo workspace:
#   protobuf-compiler  — lance-encoding / prost-build need `protoc`
#   clang / libclang   — bindgen (llama-cpp-rs, ring, etc.)
#   python3            — invoked by some build scripts (llama.cpp helpers)
#   hipblas-dev /
#   rocblas-dev        — math libs llama.cpp's GGML_HIP=ON needs at
#                        link time. The rocm/dev-ubuntu-22.04 base
#                        image ships the HIP runtime but NOT these.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git curl ca-certificates pkg-config libssl-dev \
      protobuf-compiler libprotobuf-dev \
      clang libclang-dev llvm-dev lld python3 \
      hipblas-dev rocblas-dev \
 && rm -rf /var/lib/apt/lists/*

# sccache caches rustc + hipcc + cc/c++ output keyed by content hash.
# Same wiring as Containerfile.cuda — see that file for rationale.
RUN curl -L https://github.com/mozilla/sccache/releases/download/v0.8.2/sccache-v0.8.2-x86_64-unknown-linux-musl.tar.gz \
      | tar xz -C /tmp \
 && mv /tmp/sccache-*/sccache /usr/local/bin/sccache \
 && chmod +x /usr/local/bin/sccache \
 && rm -rf /tmp/sccache-*

# Where prost-build / lance-* find the well-known google/protobuf/*.proto
# imports. `libprotobuf-dev` installs them under /usr/include.
ENV PROTOC=/usr/bin/protoc
ENV PROTOC_INCLUDE=/usr/include

# Rust toolchain. `rustfmt` is required: llama-cpp-sys-2's bindgen
# pipes its generated bindings through `rustfmt`; without it the build
# errors with `'rustfmt' is not installed for the toolchain`.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable \
 && /root/.cargo/bin/rustup component add rustfmt
ENV PATH="/root/.cargo/bin:${PATH}"

# ROCm/HIP env. Two subtleties here:
#
# 1. cmake-rs (the build-script crate llama-cpp-sys-2 uses) explicitly
#    sets `CMAKE_PREFIX_PATH=""` in its cmake invocation, which clobbers
#    whatever we put in this image's env. So we use `<Package>_ROOT`
#    env vars instead — CMake 3.12+ honors these for find_package()
#    and cmake-rs leaves them alone.
# 2. `AMDGPU_TARGETS` picks the GPU ISA at compile time. Default
#    gfx942 = MI300X. Override at build time for other AMD parts:
#        --build-arg AMDGPU_TARGETS=gfx90a   # MI250X
#        --build-arg AMDGPU_TARGETS=gfx908   # MI100
ARG AMDGPU_TARGETS=gfx942
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm
ENV PATH=/opt/rocm/bin:${PATH}
ENV AMDGPU_TARGETS=${AMDGPU_TARGETS}
ENV GPU_TARGETS=${AMDGPU_TARGETS}
# CMake find_package(<Pkg>) honors <Pkg>_ROOT env. Point at /opt/rocm
# so llama.cpp's ggml-hip CMakeLists locates each math-lib's config
# file (hipblas-config.cmake etc. under /opt/rocm/lib/cmake/<pkg>/).
ENV hip_ROOT=/opt/rocm
ENV hipblas_ROOT=/opt/rocm
ENV rocblas_ROOT=/opt/rocm
ENV hipblaslt_ROOT=/opt/rocm

# ggml-hip's static archive uses 32-bit absolute relocations
# (`R_X86_64_32`), which the default linux x86_64 PIE link rejects with
# "recompile with -fPIC". Drop PIE for this binary — analogous to the
# `-lnccl` link-arg in Containerfile.cuda.
#
# `-fuse-ld=lld` swaps the slow GNU bfd linker for LLVM lld on the
# final sovereign-cli link.
# Same stamp as Containerfile.cuda: `sovereign-pods`'s worker daemon logs it at
# startup. Pass: --build-arg GIT_SHA=$(git rev-parse --short HEAD)
ARG GIT_SHA=unknown
ENV SOVEREIGN_GIT_SHA=${GIT_SHA}
ENV RUSTFLAGS="-C link-arg=-no-pie -C link-arg=-fuse-ld=lld"

# sccache wiring. CARGO_INCREMENTAL=0 mandatory — see Containerfile.cuda.
# CMAKE_HIP_COMPILER_LAUNCHER routes ggml-hip's hipcc compiles through
# sccache; biggest single win for ROCm rebuilds.
ENV RUSTC_WRAPPER=sccache
ENV CARGO_INCREMENTAL=0
ENV SCCACHE_DIR=/root/.cache/sccache
ENV CMAKE_C_COMPILER_LAUNCHER=sccache
ENV CMAKE_CXX_COMPILER_LAUNCHER=sccache
ENV CMAKE_HIP_COMPILER_LAUNCHER=sccache

# Build context = commonwealth-ai/ workspace root, which carries the one
# workspace Cargo.toml + Cargo.lock. Cargo refuses to load the workspace when
# any `[workspace] members` entry is missing, built here or not, so every
# member is copied: each program's crates/ dir whole, then the members that
# sit outside one. Nothing else is: no crate this image builds include_str!s a
# file outside its own dir, and none has a build script.
# scripts/tests/release-build-context.sh derives the member list from the
# root manifest and fails when a member, a [patch] path or a COPY source is
# missing — this block drifted while it was a hand-kept list of crates.
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY svrn/crates/          ./svrn/crates/
COPY serve/crates/         ./serve/crates/
COPY cmnwlth/crates/       ./cmnwlth/crates/
COPY ingest/crates/        ./ingest/crates/
COPY code/crates/          ./code/crates/
COPY shared/crates/        ./shared/crates/
COPY bench/crates/         ./bench/crates/
COPY distributions/crates/ ./distributions/crates/
COPY clients/studio/            ./clients/studio/
COPY clients/desktop/src-tauri/ ./clients/desktop/src-tauri/
COPY clients/mobile/src-tauri/  ./clients/mobile/src-tauri/
COPY quality/xtask/        ./quality/xtask/
COPY quality/arch-layers/  ./quality/arch-layers/
# [patch.crates-io] in the root manifest points llama-cpp-4, llama-cpp-sys-4
# and lance-linalg at vendor/. Omitting this does not degrade gracefully:
# cargo fails the workspace load outright on a patch whose path is missing.
#
# vendor/llama-cpp-sys-4 is ~35 MB because it carries llama.cpp itself. We
# vendor it to hold the llama.cpp revision one commit ahead of what the
# published crate bundles (upstream 1464c62d88 — the Metal DSv4 Lightning
# Indexer kernel); see vendor/llama-cpp-sys-4/LLAMA_CPP_COMMIT. Resolving the
# unpatched registry crates would build a DIFFERENT llama.cpp — wrong RPC wire
# version, and a Metal worker that aborts mid-graph on DeepSeek-V4.
COPY vendor/              ./vendor/
# sovereign-cli-shared's cli_contract::manifest_path() is
# env!("SOVEREIGN_CLI_CONTRACT"); in-tree the workspace .cargo/config.toml
# sets it. That config is not copied (its linux target links with clang +
# mold, which this image does not carry), so the knob is set here: unset is
# a compile error. The value is the file's place in the source tree. Only
# `svrn contract` and the hidden dev verbs `__contract-smoke`/`__journey-plan`
# read it (sovereign-cli main.rs), and a worker pod runs none of them.
ENV SOVEREIGN_CLI_CONTRACT=/workspace/svrn/docs/cli-contract.toml

# BuildKit cache mounts persist the cargo registry, git checkouts,
# target dir, and sccache across rebuilds. See Containerfile.cuda for
# the full explanation. Binary copied out of the cached target dir into
# /usr/local/bin so the runtime stage's COPY --from=build pulls from a
# real image layer (cache mounts don't survive across stages).
RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,target=/root/.cache/sccache,sharing=locked \
    --mount=type=cache,target=/workspace/target \
    cargo build --release --bin sovereign-cli --bin sovereign-cli-daemon --bin sovereign-stock --bin sovereign-pod-worker \
 && cp /workspace/target/release/sovereign-cli          /usr/local/bin/sovereign-cli \
 && cp /workspace/target/release/sovereign-cli-daemon   /usr/local/bin/sovereign-cli-daemon \
 && cp /workspace/target/release/sovereign-stock        /usr/local/bin/sovereign-stock \
 && cp /workspace/target/release/sovereign-pod-worker   /usr/local/bin/sovereign-pod-worker \
 && sccache --show-stats

# ─── Runtime stage ───────────────────────────────────────────────────
FROM docker.io/rocm/dev-ubuntu-22.04:7.2

ENV DEBIAN_FRONTEND=noninteractive
# Runtime math libs (hipblas, rocblas) — the binary dlopen's these on
# slot load; without them the daemon segfaults when llama.cpp tries to
# init a ROCm device.
#
# Worker-mode pods no longer install Tailscale or rclone — uploads
# arrive over the owner's pinned-TLS connection, and the pod never
# joins a tailnet. See EPHEMERAL_WORKER_PODS.md "Deleted (when
# full-mesh-pods go away)".
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates unzip \
    hipblas rocblas \
    libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# The worker-mode chain (pb-pods-worker): `sovereign-cli daemon run
# --worker-mode` execs sovereign-cli-daemon, which execs
# sovereign-pod-worker; the worker's child `sovereign-cli daemon run
# --config` reaches sovereign-stock the same way.
COPY --from=build /usr/local/bin/sovereign-cli          /usr/local/bin/sovereign-cli
COPY --from=build /usr/local/bin/sovereign-cli-daemon   /usr/local/bin/sovereign-cli-daemon
COPY --from=build /usr/local/bin/sovereign-stock        /usr/local/bin/sovereign-stock
COPY --from=build /usr/local/bin/sovereign-pod-worker   /usr/local/bin/sovereign-pod-worker

# Workspace volume — RunPod mounts /workspace by default; our entrypoint
# arranges /workspace/models for owner uploads and /workspace/data for
# the worker daemon's local state.
WORKDIR /workspace
RUN mkdir -p /workspace/models /workspace/data /root/.config/sovereign

COPY serve/container/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Worker daemon's owner-only TLS surface. No client port (9741) — pods
# don't serve /v1/chat/* in worker mode.
EXPOSE 9742

ENV SOVEREIGN_DATA_DIR=/workspace/data
ENV SOVEREIGN_MODELS_DIR=/workspace/models

ENTRYPOINT ["/entrypoint.sh"]
