{
  "enabledPlugins": {},
  "includeCoAuthoredBy": false,
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/read-budget-statusline.py",
    "padding": 1
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-boot.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-notes.py",
            "type": "command",
            "timeout": 15
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/split-enforce.py",
            "type": "command",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prefer-code-intel.py",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-plan.sh",
            "type": "command",
            "timeout": 15,
            "statusMessage": "Validating plan alignment sections"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-frame.sh",
            "type": "command",
            "timeout": 15,
            "statusMessage": "Snapshotting session frame before compaction"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-frame.sh",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "sovereign"
  ],
  "mcpServers": {
    "sovereign": {
      "type": "http",
      "url": "http://localhost:9741/mcp"
    }
  }
}
