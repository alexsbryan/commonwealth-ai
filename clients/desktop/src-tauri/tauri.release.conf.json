{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-schema/main/src/tauri-conf.schema.json",
  "bundle": {
    "externalBin": [
      "binaries/sovereign-cli-daemon",
      "binaries/sovereign-stock",
      "binaries/llama-server",
      "binaries/ggml-rpc-server"
    ],
    "resources": [
      "binaries/pdfium/*",
      "binaries/llama-server.manifest.toml",
      "binaries/paddle-ocr/ppocr-en-v4v5/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libvulkan1"]
      },
      "rpm": {
        "depends": ["vulkan-loader"]
      }
    }
  }
}
