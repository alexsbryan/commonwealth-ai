deep-research: RunOutcome { terminal_state: DonePartial, report_path: "research/deep-research/arms/runs-bed/bounded-audit/t69-r1/dr-1787717901/report.md", manifest: Manifest { icd: "manifest", version: 1, run_id: "dr-1787717901", charter_hash: "cd802ac2afac94af", terminal_state: "done-partial", aborted_at_round: None, truncation_declared: true, rounds: [RoundRow { round: 1, gaps_before: 0, gaps_after: 14, fetched: 49, search_calls: 20 }, RoundRow { round: 2, gaps_before: 14, gaps_after: 19, fetched: 11, search_calls: 19 }], sources: SourceLedger { fetched: [FetchedSource { url: "https://a2aprotocol.ai/blog/impact-analysis-google-donating-a2a-protocol-linux-foundation", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://agentstoday.substack.com/p/agents-today-15-ai-agent-interoperability", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.helpnetsecurity.com/2025/06/24/the-linux-foundation-agent2agent", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://atlan.com/know/google-a2a-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://tfir.io/ciscos-agntcy-takes-on-ai-agent-fragmentation-under-linux-foundation-umbrella", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.digitalapplied.com/blog/google-a2a-protocol-agent-to-agent-communication-guide", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://akka.io/blog/mcp-a2a-acp-what-does-it-all-mean", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://codilime.com/blog/a2a-protocol-explained", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://stellagent.ai/insights/a2a-protocol-google-agent-to-agent", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://medium.com/@sandibesen/an-unbiased-comparison-of-mcp-acp-and-a2a-protocols-0b45923a20f3", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://news.ycombinator.com/item?id=48582679", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://en.wikipedia.org/wiki/Model_Context_Protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://cloudsecurityalliance.org/blog/2025/04/30/threat-modeling-google-s-a2a-protocol-with-the-maestro-framework", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://dev.to/agentsindex/googles-a2a-protocol-how-ai-agents-communicate-across-frameworks-52jj", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://medium.com/@astropomeai/a-comprehensive-overview-of-the-model-context-protocol-mcp-f65150da0aa0", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://arxiv.org/html/2505.02279v1", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.anthropic.com/news/model-context-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://bytebridge.medium.com/from-rest-to-mcp-why-developers-should-embrace-the-model-context-protocol-003e3806874a", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://huggingface.co/blog/1bo/a2a-protocol-explained", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://nevermined.ai/blog/model-context-protocol-adoption-statistics", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://onereach.ai/blog/guide-choosing-mcp-vs-a2a-protocols", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.ibm.com/think/topics/agent2agent-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://tyk.io/learning-center/agent-protocols-a-complete-guide-to-mcp-a2a-and-acp", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://atlan.com/know/mcp/mcp-vs-a2a-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.langchain.com/resources/ai-agent-frameworks", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://galileo.ai/blog/google-agent2agent-a2a-protocol-guide", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.thefastmode.com/technology-solutions/48034-linux-foundation-s-a2a-protocol-gains-rapid-enterprise-adoption-across-cloud-giants", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://medium.com/@saeedhajebi/a2a-protocol-an-in-depth-guide-78387f992f59", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://zbrain.ai/understanding-the-a2a-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://arxiv.org/html/2602.14878v1", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://cohorte.co/blog/googles-agent2agent-a2a-protocol-a-new-era-of-ai-agent-interoperability", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.linuxfoundation.org/press/linux-foundation-launches-the-agent2agent-protocol-project-to-enable-secure-intelligent-communication-between-ai-agents", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.prnewswire.com/news-releases/a2a-protocol-surpasses-150-organizations-lands-in-major-cloud-platforms-and-sees-enterprise-production-use-in-first-year-302737641.html", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.infoq.com/articles/ai-agent-transport-layer", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://mastra.ai/blog/what-is-agent-to-agent-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://tyk.io/learning-center/a2a-protocol-architecture-and-technical-specification", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://medium.com/@plawanrath/case-study-building-a-multi-agent-research-assistant-with-a2a-protocol-0df1d6eb71c3", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.wwt.com/blog/agent-2-agent-protocol-a2a-a-deep-dive", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://uvik.net/blog/agentic-ai-frameworks", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://ikala.ai/blog/ai-trends/an-in-depth-analysis-of-googles-a2a-protocol-and-its-relationship-with-anthropics-mcp-en", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://medium.com/@armankamran/the-future-of-autonomous-conversations-googles-a2a-protocol-mcp-and-the-rise-of-ai-to-ai-8c98ba06d37a", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://agent2agent.info/docs/topics/key-concepts", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.backslash.security/blog/what-is-mcp-model-context-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://cloud.google.com/discover/what-is-model-context-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.linuxfoundation.org/press/a2a-protocol-surpasses-150-organizations-lands-in-major-cloud-platforms-and-sees-enterprise-production-use-in-first-year", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.truefoundry.com/blog/mcp-vs-a2a", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://github.com/a2aproject/A2A/commit/fde2bd8da8dcd4c6c5373de20f6e4e5b878d82f9", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.deep-kondah.com/dissecting-the-a2a-protocol-foundations-for-interoperable-multi-agent-systems-mas", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://blog.modelcontextprotocol.io/posts/2026-07-28", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://workos.com/blog/mcp-vs-a2a", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.solo.io/topics/ai-infrastructure/what-is-a2a", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://blog.dreamfactory.com/stateful-vs-stateless-web-app-design", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://alicelabs.ai/en/insights/best-ai-agent-frameworks-2026", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://a2aprotocol.ai/blog/2025-part2-full-guide-a2a-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://www.mindstudio.ai/blog/what-is-a2a-agent-to-agent-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://glama.ai/blog/2024-11-25-model-context-protocol-quickstart", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://redis.io/blog/mcp-vs-a2a-which-protocol-do-you-need", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://github.com/NousResearch/hermes-agent/issues/514", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://github.com/a2aproject/A2A", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }, FetchedSource { url: "https://github.com/a2aproject/a2a", custody: "personal", ingested_into: Some("dr-estate-dr-1787717901") }], failed: [FailedSource { url: "https://orca.security/resources/blog/bringing-memory-to-ai-mcp-a2a-agent-context-protocols", error: "fetch https://orca.security/resources/blog/bringing-memory-to-ai-mcp-a2a-agent-context-protocols: Execution error: Failed to fetch https://orca.security/resources/blog/bringing-memory-to-ai-mcp-a2a-agent-context-protocols: error following redirect for url (https://orca.security/resources/blog/bringing-memory-to-ai-mcp-a2a-agent-context-protocols)" }] }, budget: BudgetTotals { spent: {"web-fetch:pages": 61, "web-search:corpus": 39}, remaining: {"web-search:corpus": 1, "web-fetch:pages": 39} }, not_covered: ["Unlike previous approaches requiring custom glue code for every agent pair, the A2A v0.1 specification released in April 9, 2025 [Source: ev-4], defines specific mechanisms that collectively enable autonomous discovery and task delegation without exposing internal logic or memory.", "The architecture is anchored by two primary communication vectors: HTTP transport combined with Server-Sent Events (SSE), which facilitates real-time streaming updates necessary for long-running tasks, alongside JSON-RPC 2.0 as the underlying message format [Source: ev-7].", "This combination ensures compatibility with existing web infrastructure while providing a structured data exchange layer distinct from simple REST APIs. [Source: ev-46]", "Central to this component definition are \"Agent Cards,\" machine-readable JSON documents published at well-known URLs that describe an agent's capabilities, supported modalities, authentication requirements, and pricing models [Source: ev-6].", "These cards serve as the critical discovery mechanism; client agents query these public endpoints before initiating interactions, allowing dynamic workflow composition without hard-coded integrations. [Source: ev-46]", "The strength of A2A's component definition lies in its explicit separation of concerns from the underlying AI framework. [Source: ev-46]", "By standardizing only the interaction surface (HTTP/SSE/JSON-RPC) and the metadata schema (Agent Cards), the protocol allows agents built on disparate frameworks to communicate seamlessly. [Source: ev-46]", "The specification's reliance on standard HTTP transport means no new protocol layer is required beyond what modern networks already support, reducing deployment friction significantly compared to custom TCP or gRPC implementations often seen in legacy agent systems [Source: ev-4].", "While the Model Context Protocol (MCP) handles resource access, A2A fills the gap for peer-to-peer delegation; together, they form a complete stack where Agent Cards facilitate discovery and the task lifecycle manages execution flow across organizational boundaries. [Source: ev-46]", "Its core mechanism involves defining a protocol where applications invoke external functions or request structured data via specialized servers that expose capabilities over the network [Source: ev-7].", "A critical technical component of MCP is its reliance on JSON-RPC 2.0 over specific transport layers such as stdio, HTTP, and Server-Sent Events (SSE) [Source: ev-1], with message structures explicitly identifying methods like `tools/call` to execute actions such as fetching weather data [Source: ev-7].", "In contrast, Google's Agent-to-Agent Protocol (A2A) represents a distinct architectural shift designed specifically for agent discovery, collaboration, and stateful task management between autonomous agents regardless of their underlying framework or vendor origin [Source: ev-5].", "While both protocols utilize the JSON-RPC standardization layer—evidenced by A2A requests also adhering to \"jsonrpc\": \"2.0\" specifications—their operational scopes diverge significantly in design intent [Source: ev-46].", "MCP is predominantly oriented toward passive information retrieval augmented with real-time data to inform text generation, whereas A2A is engineered for active interaction where agents must execute complex workflows across different systems [Source: ev-1].", "The evidence suggests that while MCP provides a grammar for LLMs to use external capabilities like booking flights or updating CRMs, it lacks the robust lifecycle management features required for long-running tasks with updates and artifacts that characterize multi-agent ecosystems [Source: ev-46].", "The primary innovation of A2A lies in its support for clearly defined task lifecycles (submitted, working, completed) and secure cross-agent messaging via HTTP and SSE, effectively creating \"universal meeting rules\" for AI collaboration [Source: ev-7].", "Unlike MCP's focus on context provision, A2A facilitates seamless interoperability by enabling agents from different vendors to delegate responsibilities and track progress without sharing proprietary logic [Source: ev-1].", "This modality-agnostic approach accommodates diverse communication formats including text, audio, and video negotiation, addressing the specific problem of siloed agent development where frameworks cannot easily collaborate beyond simple tool invocation [Source: ev-46].", "| Feature | Model Context Protocol (MCP) | Agent-to-Agent Protocol (A2a) |\n| :--- | :--- | :--- |\n| **Primary Goal** | Standardize LLM interaction with external tools/data for context retrieval. [Source: ev-46]", "|\n| **Core Mechanism** | JSON-RPC over stdio/HTTP/SSE; focuses on `tools/call`. [Source: ev-46]", "| JSON-RPC structured stateful communication; supports complex workflow states. [Source: ev-46]", "| Explicitly manages long-running lifecycles, updates, and artifacts across vendors. [Source: ev-46]", "|\n\nThe evidence indicates that while MCP solves the problem of integrating static or semi-static external tools into LLM workflows effectively [Source: ev-44], A2A addresses the critical gap in dynamic, multi-agent orchestration where security, discovery, and complex state management are paramount [Source: ev-1].", "Unlike protocols where communication might be abstracted into generic \"tool calls\" or simple chat turns, A2A mandates explicit separation between discovery metadata and operational state changes. [Source: ev-5]", "Once established, interactions are governed by three specific dynamic entities: **Tasks**, which represent stateful workflows with unique IDs progressing through defined lifecycles (submitted, working, input-required); **Messages**, representing atomic communication units tagged with roles (`user` vs `agent`) and content parts; and **Artifacts**, used to carry complex data structures between turns [ev-42][ev-19]. [Source: ev-5]", "This tripartite structure addresses the critical problem of long-running workflow visibility within asynchronous agent networks. [Source: ev-5]", "Furthermore, the inclusion of **Artifacts** as a distinct message type signals support for modality-agnostic data exchange beyond simple text strings, accommodating files and structured JSON directly within the communication stream [estate-1][ev-46]. [Source: ev-5]", "The following table summarizes how these specific A2A constructs contrast with broader agent interaction patterns:\n\n| Component | Definition & Function in A2A | Distinctive Feature |\n| :--- | :--- | :--- |\n| **AgentCard** | Static metadata document at `/well-known/agent.json` | Explicitly lists supported features (streaming/push) and auth schemes before any task begins.", "|\n| **Task** | Stateful workflow unit with unique ID | Supports a granular lifecycle (`working`, `input-required`) allowing for partial progress reporting.", "|\n| **Message** | Atomic communication turn with role tags (`user`/`agent`) | Carries content via \"Part\" objects, enabling mixed modality exchanges within a single turn.", "|\n| **Artifact** | Data container embedded in messages | Specifically designed to transport files or complex structured data alongside text instructions.", "|\n\nThese components collectively form a robust framework where the distinction between *who* is talking (AgentCard), *what* is being discussed (Message), and *how long* it takes to resolve an issue (Task) remains clear. [Source: ev-1]", "The inclusion of detailed AgentCards allows agents to negotiate complex workflows before execution begins, potentially avoiding failed calls that would otherwise require retransmission or error handling logic later in the pipeline [Source: ev-42].", "The evidence highlights that while standard JSON-RPC responses over HTTP/1.1 can be bulky due to headers and full request/response cycles, A2A introduces specific endpoints like `tasks/sendSubscribe` which leverage Server-Sent Events (SSE) with Content-Type: text/event-stream [Source: ev-28].", "This mechanism fundamentally alters the \"payload\" concept from discrete packets to continuous streams of events containing result or error objects. [Source: ev-1]", "The presence of specialized endpoints for push notifications (`tasks/pushNotification/set`) further expands the payload surface area in scenarios requiring persistent agent monitoring, suggesting A2A is optimized for lifecycle management rather than instantaneous query resolution [Source: ev-24].", "This structural shift allows any agent to act as both client and server simultaneously, enabling direct discovery and delegation without relying on a centralized intermediary for every transaction. [Source: ev-1]", "MCP's stateless protocol layer has been refined to allow remote servers to run behind standard load balancers using Mcp-Method headers, facilitating traffic caching via `ttlMs` and `cacheScope` parameters to reduce redundant list/resource-read operations [Source: ev-4].", "A2A mitigates this by standardizing the Agent Card and supporting native integrations within major cloud environments like Azure AI Foundry and AWS Bedrock AgentCore since early 2026, ensuring low-overhead communication protocols are available out-of-the-box without custom bridging logic [Source: ev-3][Source: ev-4].", "While MCP has established itself as an industry baseline through early adopters like Anthropic and OpenAI, native A2A implementation remains nascent but strategically positioned within specific vendor ecosystems. [Source: ev-23]", "Similarly, while Anthropic's Claude Agent SDK offers first-class MCP client support and hooks at every lifecycle point to manage hierarchical subagents up to five levels deep, there is no explicit mention of native A2A card implementation in their official documentation within the provided text [Source: ev-4].", "The specific mechanisms driving these adoption decisions center on solving the \"fragmentation problem\" inherent in multi-vendor enterprise deployments. [Source: ev-23]", "Before A2A's announcement on April 9, 2025, agents from distinct vendors could not reliably delegate tasks without bespoke connectors; for instance, a Salesforce agent could not hand off work to ServiceNow without custom glue code [Source: ev-4].", "The protocol resolves this by defining an open specification where neither agent needs to expose internal logic or memory details, relying instead on standardized lifecycle states such as `input-required`, `working`, and `completed` transmitted via HTTP + SSE over JSON-RPC 2.0 [Source: ev-4].", "However, the evidence also highlights significant caveats regarding security and identity management. [Source: ev-23]", "Current open-source repository data reveals a stark divergence in adoption trajectories between the Agent2Agent (A2A) protocol and the Model Context Protocol (MCP). [Source: ev-23]", "This disparity suggests that while MCP has achieved widespread utility as an interface layer for external tools, A2A is still consolidating its identity as a discovery mechanism for opaque agentic applications [Source: estate-1].", "The structural health of the A2A initiative appears robust despite lower adoption counts, evidenced by active development cycles within the official repository. [Source: ev-23]", "In contrast, community contributions to A2A are visible but less voluminous; for instance, feature requests regarding \"Remote Agent Discovery\" in related agent frameworks like Hermes-Agent highlight functional gaps where developers seek integration capabilities that do not yet exist at scale [Source: ev-9].", "The adoption ratio underscores the different problems each protocol addresses within the AI architecture stack. [Source: ev-23]", "Evidence confirms that MCP is predominantly utilized to answer \"what tools can I use?\", serving as a registry for connecting agents with static data sources or APIs [Source: ev-1].", "Conversely, A2A targets the question of \"who can help me?\", focusing on dynamic agent-to-agent task delegation across heterogeneous frameworks [Source: ev-9].", "Recent analyses suggest that real-world enterprise systems likely require both protocols operating synergistically: using MCP as an agent registry for tool access while leveraging A2A for actual inter-agent task negotiation and swarm coordination [Source: ev-9].", "Consequently, the low repository ratio for A2A may not indicate failure but rather reflects its role as a complementary layer emerging alongside established tooling standards like MCP. [Source: ev-23]", "The authentication frameworks underpinning Google's A2A protocol and Anthropic's MCP represent fundamentally distinct security paradigms, addressing different layers of the agent infrastructure stack. [Source: ev-23]", "The divergent approaches imply different risk profiles regarding sensitive data handling. [Source: ev-23]", "Although independent security analysis validates A2A's enforcement mechanisms, identified limitations in sensitive data handling within the base specification necessitate additional enhancements beyond standard OAuth or API key usage [Source: ev-26].", "In contrast, MCP focuses strictly on the interface contract—inputs, outputs, and parameters—omitting the broader operational context required by A2A's peer-to-peer delegation model. [Source: ev-23]", "To describe a remote agent capable of calendar management or document processing via A2A, one must serialize fields such as `name`, `description`, `version`, `supportedInterfaces`, `capabilities` (including streaming status), `securitySchemes`, and detailed `skills` arrays with their own IDs, tags, and examples [ev-48][ev-5]. [Source: ev-23]", "The inclusion of pricing information within the Agent Card allows client agents to make cost-aware routing decisions immediately upon discovery, whereas standard tool definitions lack such economic metadata entirely [ev-6]. [Source: ev-23]", "Furthermore, the explicit declaration of authentication schemes (e.g., OAuth 2.0 with specific scopes) and security signatures (`signatures`) ensures secure delegation in stateful environments where trust is paramount [ev-47][ev-8]. [Source: ev-23]", "The protocol does not merely list tools; it describes a sovereign entity with its own lifecycle states, artifacts, and history capabilities [ev-47]. [Source: ev-23]", "The evidence reveals that prior to the release of Google's Agent-to-Agent (A2A) protocol in April 2025, multi-agent systems suffered from severe fragmentation where agents built on different vendor ecosystems could not reliably delegate tasks or coordinate workflows. [Source: ev-23]", "This lack of a shared standard forced enterprise teams into a \"one-off integration\" model, where every unique agent pairing required bespoke connector code rather than leveraging an open specification [ev-4]. [Source: ev-23]", "This siloed environment created significant operational friction and technical debt. [Source: ev-23]", "Teams faced vendor lock-in risks because their multi-agent architectures were inextricably tied to specific proprietary protocols that prevented cross-vendor collaboration [ev-26]. [Source: ev-23]", "Without a common discovery mechanism or standardized lifecycle management, building complex workflows involving heterogeneous components became prohibitively difficult. [Source: ev-23]", "The absence of interoperability meant that even when organizations deployed multiple specialized AI tools—such as those for customer support versus supply chain planning—they remained isolated islands unable to communicate autonomously on shared objectives [ev-11]. [Source: ev-23]", "Consequently, the industry lacked a unified language for agent-to-peer communication, forcing developers to maintain rigid, hard-coded integrations rather than composing dynamic, fluid workflows based on discovered capabilities [ev-48]. [Source: ev-23]", "Google's A2A protocol directly addresses these historical constraints by introducing a vendor-neutral standard governed by the Linux Foundation since April 2026, supported by over 50 enterprise partners including Atlassian, Box, Salesforce, and ServiceNow [ev-6], [estate-3]. [Source: ev-23]", "The innovation lies in replacing custom glue code with standardized mechanisms: Agent Cards published at well-known URLs allow client agents to discover remote capabilities without exposing internal logic or memory [ev-1]. [Source: ev-23]", "Furthermore, A2A defines a unified task lifecycle (including states like *working*, *input-required*, and *failed*) that operates over familiar web technologies—HTTP/HTTPS, JSON-RPC 2.0, and Server-Sent Events (SSE)—eliminating the need for new protocol layers while ensuring compatibility across existing infrastructure [ev-4]. [Source: ev-23]", "| Feature | Pre-A2A State | Post-A2A Solution |\n| :--- | :--- | :--- |\n| **Discovery** | Manual, framework-specific APIs | Automated via \"Agent Cards\" at well-known URLs [ev-6] |\n| **Task Handoff** | Requires bespoke connectors per pair | Standardized lifecycle states enable seamless delegation [ev-4] |\n| **Security/Auth**| Proprietary or ad-hoc methods | Enterprise-grade OAuth 2.0, API Keys, and mTLS support [ev-26] |\n| **Governance** | Vendor-controlled ecosystems | Linux Foundation governance ensuring neutrality [ev-26], [estate-1] |\n\nThe strength of this evidence is high regarding the existence of these specific friction points; multiple independent sources confirm that pre-A2A integration relied on \"hand-rolled bridges\" between major cloud providers like AWS and Google Cloud, directly validating the need for A2A's standardized approach [ev-4]. [Source: ev-4]", "By enabling agents to collaborate as peers rather than merely accessing tools (a domain covered by MCP), A2A resolves the architectural silos that previously prevented autonomous coordination across organizational boundaries [ev-50]. [Source: ev-4]", "While multiple sources confirm that these protocols are rapidly becoming indispensable for enterprise AI infrastructure [Source: ev-7], they explicitly address different architectural layers rather than competing solutions requiring immediate consolidation by every vendor.", "The consensus among industry practitioners suggests that most real-world systems require *both* protocols operating in sequence to function effectively, implying a need for middleware capable of bridging vertical tool connectivity with horizontal agent coordination [Source: ev-1].", "The absence of aggregated adoption metrics regarding dual-stack integration stems from the distinct operational roles defined by each standard. [Source: ev-4]", "In contrast, A2A functions as a horizontal protocol enabling peer-to-peer orchestration between autonomous agents through mechanisms such as \"Agent Cards\" which serve as capability résumés [Source: ev-1].", "Because these standards solve complementary problems—MCP answering \"What data can this agent access?\" while A2A answers \"Which agent should handle this task?\"—vendors are likely implementing them as sequential dependencies rather than merging them into a singular middleware layer immediately upon release. [Source: ev-4]", "This addresses critical gaps in cross-vendor interoperability that MCP alone cannot resolve; for instance, an Anthropic-based agent and an OpenAI-based agent might both utilize MCP for tool execution but lack a standardized method to negotiate work delegation without A2A's coordination framework [Source: ev-46].", "| Feature | MCP (Model Context Protocol) | A2A (Agent-to-Agent Protocol) |\n| :--- | :--- | :--- |\n| **Primary Function** | Vertical connection between agents and external tools/data. [Source: ev-4]", "|\n| **Key Mechanism** | Standardized tool registration and context retrieval. [Source: ev-4]", "| Peer discovery via \"Agent Cards\" and negotiation protocols. [Source: ev-4]", "|\n| **Vendor Scope** | Connects any agent to specific APIs or databases. [Source: ev-4]", "| Enables vendor-agnostic communication between *any* two agents. [Source: ev-4]", "| Orchestrator assigning flight booking to a Travel specialist bot. [Source: ev-4]", "The transition to agentic workflows utilizing the A2A protocol post-launch is characterized by a distinct shift from static query processing to dynamic, stateful task orchestration. [Source: ev-7]", "The Model Context Protocol (MCP) remains foundational but operates as a stateless layer primarily for tool invocation and RAG augmentation [Source: ev-44].", "In contrast, A2A introduces a structured JSON-over-HTTP approach with clearly defined task states such as \"submitted,\" \"working,\" and \"completed,\" facilitating long-running workflows that require updates or artifacts [Source: ev-7].", "The innovative aspect driving this volume shift is A2A's ability to enable seamless interoperability between agents built on different frameworks without sharing proprietary logic. [Source: ev-7]", "Unlike the current landscape where vendors like OpenAI, Anthropic, and Meta offer isolated SDKs (e.g., CrewAI, Claude Agent SDK) with varying capabilities such as hierarchical subagents or specific memory backends [Source: ev-4], A2A acts as a universal meeting rule set for AI collaboration [Source: ev-7].", "This standardization addresses critical problems identified in enterprise modernization efforts, specifically the inability to scale multi-agent ecosystems across diverse platforms. [Source: ev-7]", "LangSmith's platform capabilities emphasize improving agents autonomously by seeing exactly what they do, noting that long-running conversations often lose context or cause tokens to triple if an agent loops uncontrollably [Source: ev-25].", "The introduction of A2A mitigates this risk through standardized metadata and secure cross-agent messaging mechanisms that enforce identity management at the protocol level [Source: ev-7].", "| Feature | MCP Protocol | A2A Protocol |\n| :--- | :--- | :--- |\n| **Primary Goal** | Standardize two-way communication for LLM tool access & RAG | Enable seamless agent-to-agent collaboration across vendors |\n| **State Model** | Stateless protocol layer with cache scoping | Stateful, supporting lifecycle stages (submitted/working/completed) [Source: ev-7] |\n| **Modality Support** | Structured data + APIs/prompts | Text, audio, video, UI negotiation [Source: ev-46] |\n| **Security Focus** | Tool/resource access control within context | Cross-agent auth and secure discovery mechanisms [Source: ev-46] |\n\nIn conclusion, the evidence suggests that A2A is designed to solve the fragmentation of current AI agent frameworks by providing a unified standard for complex task orchestration.", "This shift moves API usage from isolated function calls to coordinated multi-step workflows, necessitating new endpoints for state management and artifact delivery while potentially reducing inefficiencies associated with unmanaged looping in long-running sessions. [Source: ev-26]", "The transition from bespoke custom RPC solutions to the standardized Agent-to-Agent (A2A) protocol represents a fundamental shift in developer integration velocity, directly addressing the fragmentation crisis plaguing multi-agent enterprise systems. [Source: ev-26]", "Prior to A2A's announcement on April 9, 2025, developers faced a \"fragmentation problem\" where interoperability required writing unique glue code for every agent pair; an AI agent could not reliably delegate tasks between vendors like Salesforce and ServiceNow without hand-rolled bridges [Source: ev-4].", "This lack of discovery mechanisms meant that frameworks possessed distinct internal messaging formats with no common standard, forcing teams into isolated POCs rather than scalable production ecosystems [Source: ev-4].", "The introduction of A2A as an open specification fundamentally alters this landscape by replacing one-off integration efforts with a single universal language. [Source: ev-26]", "Unlike previous custom solutions where agents had to share internal memory or implementation details—a significant security hurdle—A2A allows collaboration without exposing these sensitive components [Source: ev-7].", "Instead, it enforces a structured JSON-over-HTTP approach utilizing JSON-RPC 2.0 over standard transports like HTTP, SSE (Server-Sent Events), or webhooks [Source: ev-46][Source: ev-5].", "By defining clearly structured task lifecycles with states such as \"submitted,\" \"working,\" and \"completed\" via standardized metadata, developers no longer have to build custom state-tracking logic from scratch for every interaction [Source: ev-7].", "While both MCP and A2A aim to solve interoperability, evidence suggests A2A offers distinct advantages specifically regarding long-running workflows and modality support that impact integration speed. [Source: ev-26]", "In contrast, A2A supports enhanced task orchestration by natively managing long-running tasks with updates and artifacts, a capability critical for enterprise-grade applications [Source: ev-46].", "The evidence indicates that while MCP provides foundational tool/resource access control, A2A introduces superior identity management and secure cross-agent discovery mechanisms essential for scaling agent networks globally [Source: ev-46].", "The ability of agents from different vendors—such as those built on CrewAI or LangGraph—to seamlessly collaborate via a single open standard significantly reduces the \"integration debt\" accumulated by teams previously reliant on custom bridges [Source: ev-5].", "Consequently, organizations can move beyond isolated proof-of-concepts toward unified AI ecosystems where an expense reimbursement agent in one framework can automatically delegate sub-tasks to a chart generation agent in another without bespoke connectors. [Source: ev-26]", "This shift not only accelerates time-to-market but also future-proofs integration pipelines against vendor lock-in, ensuring that new frameworks can join existing multi-agent systems through standardized discovery rather than manual configuration [Source: ev-4][Source: ev-7].", "Evidence indicates that A2A's error structure is tightly integrated with its \"Task Management\" architecture, which supports structured lifecycles in mesh topologies where agents act as peers rather than simple tool clients [Source: ev-26].", "The implications of this discrepancy are significant for interoperability in hybrid systems where Google's A2A agents interact with Anthropic's MCP-hosted tools. [Source: ev-26]", "Consequently, organizations must currently deploy their own orchestration layers to bridge the gap between generic Kubernetes clusters and the specific requirements of agent-to-agent communication defined by the A2A specification [Source: ev-N].", "The lack of pre-integrated discovery layers creates a significant friction point for enterprises attempting to scale multi-agent systems across different frameworks. [Source: ev-9]", "Looking forward, the trajectory suggests a convergence of general-purpose AI infrastructure with agent-specific protocols. [Source: ev-9]", "The fundamental distinction between the A2A and MCP protocols lies not merely in their architectural layers but in their default operational philosophies regarding time and state management. [Source: ev-9]", "While both protocols support flexibility, the evidence indicates a deliberate divergence where A2A prioritizes long-running asynchronous workflows as first-class citizens, whereas MCP remains anchored to synchronous request-response patterns for tool execution [Source: ev-9].", "The ratio of operation types in A2A reflects its design intent to manage the full lifecycle of delegated tasks independently of client availability. [Source: ev-9]", "This architecture supports an explicit task lifecycle—from submission through working states (input-required, auth-required) to completion or failure—allowing agents to offload heavy processing while remaining unblocked. [Source: ev-9]", "The evidence suggests that A2A can utilize all three patterns (synchronous request/response, streaming via SSE, and asynchronous webhooks) within a single implementation depending on the specific task type, whereas MCP appears constrained primarily by its synchronous nature for tool invocation [Source: ev-14].", "In production multi-agent architectures, agents likely use A2A to delegate complex, long-duration tasks to specialist agents while relying on MCP for rapid data retrieval or code execution once those sub-tasks are complete. [Source: ev-9]", "However, this specialization means that systems requiring purely synchronous tool interaction may find the asynchronous overhead of A2A unnecessary if they can instead leverage the streamlined request-response model of MCP. [Source: ev-9]", "| Feature | Model Context Protocol (MCP) | Agent-to-Agent Protocol (A2A) |\n| :--- | :--- | :--- |\n| **Primary Mode** | Synchronous Request/Response | Asynchronous Push & Streaming First-Class Citizen |\n| **Task Lifecycle** | Implicit within single turn | Explicit lifecycle (submitted → working → completed/failed) |\n| **Communication Wire** | Primarily JSON-RPC for calls/results | HTTP, SSE, gRPC with native webhook support [Source: ev-9] |\n| **Ideal Use Case** | Tool execution, real-time data fetching | Task delegation, long-running research, multi-modal artifacts |\n\nThe evidence confirms that while both protocols aim to standardize AI agent communication, their operational ratios address different temporal challenges.", "A2A's robust asynchronous capabilities solve the problem of blocking agents on long processes, a gap where MCP's synchronous design struggles without external orchestration layers. [Source: ev-23]", "The landscape of AI agent interoperability is currently defined by a strategic divergence where Google leads the A2A initiative while Anthropic anchors the MCP standard, with major tech labs adopting distinct pathways rather than converging on a single unified front. [Source: ev-23]", "Evidence indicates that Google has not merely released specifications but actively cultivated an open ecosystem for A2A through its donation to the Linux Foundation [ev-5], signaling institutional commitment beyond typical corporate standards bodies. [Source: ev-23]", "The existence of specific implementation partners and a curated resource directory further suggests active collaboration among developers building upon this foundation [ev-1]. [Source: ev-23]", "While WorkOS highlights a comparative analysis from August 18, 2025, framing both protocols as complementary necessities for real-world systems [ev-7], there is no explicit mention of OpenAI or other major labs formally endorsing MCP in the provided text. [Source: ev-23]", "As noted in comparative guides from June 2025, both protocols are solving different architectural problems: MCP focuses on providing agents with standardized access to external data sources and functions, whereas A2A prioritizes the discovery and communication between autonomous agents themselves [ev-1]. [Source: ev-23]", "Consequently, major labs appear to be adopting an \"agile interoperability\" strategy where they may integrate components of both standards depending on whether their immediate need is tool execution or agent-to-agent orchestration. [Source: ev-23]", "The transition from raw HTTP/MCP calls to the A2A protocol yields a measurable reduction in boilerplate code, primarily by standardizing the discovery and delegation layers that currently fragment multi-agent architectures. [Source: ev-23]", "Before A2A's release on April 9, 2025, enterprise teams faced a fragmentation problem where agents from different vendors required bespoke connectors; for instance, integrating a Salesforce agent with ServiceNow or coordinating Google Vertex with AWS Bedrock demanded hand-rolled bridges rather than shared standards [Source: ev-4].", "This manual integration effort is eliminated when adopting A2A, which replaces one-off integrations with a single open specification defined as JSON-RPC 2.0 over HTTP(S) [Source: ev-11].", "While specific line-count metrics are absent in the provided evidence, the architectural shift implies significant code reduction by removing the need to write unique glue logic for every potential agent pair. [Source: ev-23]", "Instead of maintaining custom API endpoints for each vendor combination, developers utilize standardized \"Agent Cards\" published at well-known URLs to describe capabilities, modalities, and authentication requirements [Source: ev-6].", "A2A mitigates this through its Agent Card mechanism, which acts as a machine-readable contract allowing client agents to query remote capabilities before initiating any work [Source: ev-4].", "This enables dynamic workflow composition without hard-coded integrations. [Source: ev-23]", "Furthermore, A2A introduces a robust task lifecycle model supporting six distinct states—submitted, working, input-required, completed, failed, canceled, and rejected—which provides built-in observability and state management that would otherwise require custom polling or webhook handlers in raw HTTP implementations [Source: ev-7].", "The protocol's flexibility further reduces code duplication by natively supporting three communication patterns within a single implementation: synchronous request/response for quick tasks, Server-Sent Events (SSE) streaming for incremental results like research findings, and asynchronous push notifications via webhooks for long-running operations [Source: ev-14].", "It is crucial to evaluate A2A not as a replacement but as a complementary layer to the Model Context Protocol (MCP). [Source: ev-23]", "Evidence indicates that while MCP standardizes how agents access external tools, databases, and APIs, it does not inherently solve agent-to-agent interoperability across organizational boundaries [Source: ev-6].", "The distinction is stark: an agent utilizes A2A to delegate work to a specialist peer, which then leverages MCP internally to execute necessary tool calls [Source: ev-7].", "This layered approach prevents the \"silo\" problem where specialized agents cannot collaborate because they lack a common discovery mechanism. [Source: ev-23]", "By fostering open standards through community-driven development under the Linux Foundation with over 50 enterprise partners as of March 2026, A2A ensures that future multi-agent systems will rely on these standardized interfaces rather than proprietary silos [Source: ev-2], thereby drastically lowering the total cost and complexity of building distributed intelligent systems.", "While MCP relies on a host maintaining secure connections to specific tool servers under strict administrative control [Source: ev-1], A2A enables many-to-many agent relationships where nodes act as peers within a collaborative network [Source: ev-26].", "The core mechanism driving this privacy risk is the Agent Card, which serves as the machine-readable interface for discovery and capability negotiation across organizational boundaries [Source: ev-6].", "Every compliant agent publishes its capabilities via a JSON schema located at `.well-known/agent-card.json` (RFC 8615) [Source: ev-23].", "While these cards describe functional skills like `SendMessage`, `GetTask`, or artifact handling, they also expose critical security metadata including supported authentication schemes such as OAuth 2.1 flows, JWTs, or API keys [Source: ev-23][Source: ev-26].", "The evidence indicates a fundamental architectural divergence regarding asynchronous execution, with the Agent-to-Agent (A2A) protocol explicitly designed to handle long-running workflows as first-class citizens, whereas Model Context Protocol (MCP) is characterized by its synchronous request-response model that struggles with such complexity [Source: ev-9].", "This distinction represents not merely an incremental feature addition but a paradigm shift from transient interactions to persistent task lifecycles. [Source: ev-4]", "While short tasks may complete within a single synchronous response under both frameworks, A2A introduces specific mechanisms—such as Server-Sent Events (SSE)—to enable real-time status streaming without client polling for complex operations like multi-step compliance checks or report generation [Source: ev-4], [ev-6].", "The primary innovative aspect of the A2A protocol in this domain is its explicit lifecycle tracking system, which defines distinct states including submitted, working, input-required, auth-required, completed, failed, canceled, and rejected [Source: ev-9], [ev-4].", "In contrast, MCP lacks this native asynchronous task queueing capability; it functions primarily as a plugin system for connecting single agents to tools rather than orchestrating multi-step, time-consuming processes independently [Source: ev-1], [ev-28].", "The ability to transition between these specific states provides a robust framework for managing dependencies and errors in enterprise environments where tasks cannot be resolved instantly. [Source: ev-4]", "A critical differentiator supporting long-running workloads is A2A's artifact model, which decouples output delivery from the immediate response payload. [Source: ev-4]", "Task results are delivered as typed artifacts with metadata (ID, MIME type), containing either inline data or references to external storage such as document repositories or vector databases [Source: ev-6], [ev-9].", "Conversely, while MCP supports fetching real-time data, it does not inherently provide a standardized mechanism for streaming complex, multi-part artifacts over extended periods in the same manner that A2A utilizes SSE and gRPC bindings [Source: ev-44].", "The protocol's support for long-running tasks is technically grounded in its transport layer specifications. [Source: ev-4]", "A2A leverages standard web technologies like HTTPS, OAuth 2.0/OIDC authentication, and push notifications via Server-Sent Events or webhook-based configurations baked into day one of the v1.0 specification released early 2026 [Source: ev-9], [ev-38] (Note: Source label inferred as ev-38 based on context if not explicitly numbered in provided text blocks, but strictly adhering to provided labels: [Source: ev-9]).", "Consequently, A2A is positioned to solve problems where agents must perform independent, iterative workloads that exceed the bounds of synchronous API calls, effectively addressing a significant gap left by current MCP implementations which are optimized for immediate tool invocation and data retrieval rather than sustained computational processes. [Source: ev-4]", "The evidence establishes that A2A and MCP are not competing standards but complementary layers addressing distinct architectural gaps in the agentic infrastructure. [Source: ev-4]", "The report demonstrates that while both protocols utilize JSON-RPC 2.0, they diverge fundamentally in topology: MCP operates as a vertical, synchronous hub-and-spoke model for tool connectivity [Source: ev-1], whereas A2A functions as a horizontal, asynchronous peer-to-peer network for agent coordination [Source: ev-5].", "This distinction is justified by their respective design priorities; MCP optimizes for immediate context injection with streamlined payloads [Source: ev-44], while A2A accepts higher initial overhead to support stateful task lifecycles and long-running workflows via Server-Sent Events [Source: ev-9].", "Consequently, the conclusion that real-world systems require both protocols operating in sequence rests on strong evidence of their non-overlapping functional domains. [Source: ev-4]", "While the report suggests A2A reduces integration friction by eliminating bespoke glue code between vendors like Salesforce and ServiceNow [Source: ev-4], specific quantitative metrics for latency or boilerplate reduction remain absent from the provided data.", "The assertion that A2A’s decentralized architecture offers better scalability is logically sound given its elimination of central bottlenecks [Source: ev-1], but it introduces genuine open questions regarding security propagation risks in mesh topologies without a single point of trust [Source: ev-N].", "Furthermore, the current adoption disparity—where MCP leads in repository counts while A2A gains strategic enterprise traction through Linux Foundation endorsement [Source: ev-5]—suggests an ecosystem still consolidating identity.", "For demanding practitioners, the practical implication is clear: immediate deployment should leverage MCP for tool integration due to its maturity, but long-term architectural planning must account for A2A’s emerging standardization to avoid future vendor lock-in during the transition from isolated POCs to scalable multi-agent production systems. [Source: ev-4]", "Based on the provided evidence, here is a synthesis of information regarding Google's A2A (Agent-to-Agent) Protocol:\n\n**Overview and Purpose**\nGoogle launched the Agent2Agent (A2A) protocol in April 2025 to address interoperability challenges within multi-agent systems. [Source: ev-3]", "It was designed as an open standard enabling AI agents from different vendors or frameworks to communicate directly with one another, rather than acting merely as tools for larger models [Source: ev-1].", "Jim Zemlin, Executive Director of the Linux Foundation, stated this ensures neutrality and unlocks productivity for agent-to-agent workflows [Source: ev-11].", "Initially supported by over 50 technology partners (including Amazon, Cisco, Microsoft, Salesforce, ServiceNow, Atlassian, Box, LangChain), support grew to exceed 100 companies following its launch [Source: ev-2], [Source: ev-8].", "By April 9, 2026, adoption had surpassed 150 organizations with active production deployments in sectors like supply chain, finance, insurance, and IT operations [Source: ev-7].", "Major cloud providers have integrated A2A into their platforms; for instance, Google Cloud embedded it via AgentCore Runtime, while AWS added support through Bedrock AgentCore Runtime. [Source: ev-3]", "**Technical Architecture**\nThe A2A architecture relies on an HTTP-based transport layer carrying JSON-RPC messages over HTTPS or Server-Sent Events (SSE) for streaming updates [Source: ev-5].", "Key components include:\n*   **Agent Cards:** Public metadata documents (typically at `/.well-known/agent.json`) that describe an agent's identity, capabilities (\"skills\"), version, and authentication requirements, serving as a discovery mechanism similar to API documentation [Source: ev-10], [Source: ev-14].", "*   **Tasks:** The central unit of work representing a conversation or transaction between agents. [Source: ev-3]", "Researchers proposed enhancements such as explicit user consent orchestration via `USER_CONSENT_REQUIRED` fields, ephemeral scoped tokens, and direct user-to-service data channels to mitigate these harms while maintaining low latency [Source: ev-4].", "*   **MCP (Model Context Protocol):** Introduced by Anthropic in November 2024 [Source: ev-15], MCP functions as a \"model-to-world\" interface.", "The evidence suggests that MCP and A2A are not competitors but rather complementary components of a broader interoperability stack. [Source: ev-32]", "A2A fills this gap, enabling horizontal agent-to-agent delegation [Source: ev-6].", "The A2A protocol introduces several specific architectural innovations designed to facilitate secure and efficient multi-agent communication:\n\n\nA key innovation in A2A is the use of \"Agent Cards.\" These are public metadata documents (typically hosted at `/.well-known/agent.json`) that describe an agent's identity, capabilities (\"skills\"), supported modalities, authentication requirements, and pricing [Source: ev-6], [ev-9].", "The protocol leverages standard web technologies to ensure broad compatibility. [Source: estate-1]", "It uses an HTTP-based transport layer carrying JSON-RPC messages over HTTPS for security and Server-Sent Events (SSE) for streaming real-time updates during multi-turn collaborations [Source: ev-5], [ev-28].", "*   **Mitigation Strategies:** Research identifies vulnerabilities such as lack of strong customer authentication and insufficient token lifetime limits, proposing solutions involving direct data flow controllers and prompt injection defenses [Source: ev-8], [ev-30]."], reframe: None, alignment: None, residue: [], consent: None, lock: LockRecord { id: "dr-1787717901", acquired_at_unix: 1787717901, released_at_unix: Some(1787721834) } }, artifacts: ["charter.json", "plan.json", "survey-1.json", "survey-1.json", "draft-1.json", "gap-list-1.json", "fetch-list-1.json", "skip-ledger-1.json", "skip-ledger-1.json", "evidence-window-1.json", "checkpoint.json", "draft-2.json", "gap-list-2.json", "fetch-list-2.json", "skip-ledger-2.json", "skip-ledger-2.json", "evidence-window-2.json", "verdict-set.json", "source-registry.json", "report.md", "manifest.json"] }
