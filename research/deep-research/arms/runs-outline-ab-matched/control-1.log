deep-research: RunOutcome { terminal_state: DonePartial, report_path: "/home/alexbryan/dev/commonwealth-ai/research/deep-research/arms/runs-outline-ab-matched/control-1/dr-1787669880/report.md", manifest: Manifest { icd: "manifest", version: 1, run_id: "dr-1787669880", charter_hash: "af5e55bf86b94bf1", terminal_state: "done-partial", aborted_at_round: None, truncation_declared: true, rounds: [RoundRow { round: 1, gaps_before: 0, gaps_after: 12, fetched: 49, search_calls: 20 }, RoundRow { round: 2, gaps_before: 12, gaps_after: 21, fetched: 7, search_calls: 20 }], sources: SourceLedger { fetched: [FetchedSource { url: "https://nevermined.ai/blog/model-context-protocol-adoption-statistics", custody: "personal", ingested_into: Some("dr-estate-dr-1787669880") }, FetchedSource { url: "https://www.anthropic.com/news/model-context-protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787669880") }, FetchedSource { url: "https://agentstoday.substack.com/p/agents-today-15-ai-agent-interoperability", custody: "personal", ingested_into: Some("dr-estate-dr-1787669880") }, FetchedSource { url: "https://workos.com/blog/mcp-vs-a2a", custody: "personal", ingested_into: Some("dr-estate-dr-1787669880") }, FetchedSource { url: "https://tfir.io/ciscos-agntcy-takes-on-ai-agent-fragmentation-under-linux-foundation-umbrella", custody: "personal", ingested_into: Some("dr-estate-dr-1787669880") }, FetchedSource { url: "https://www.digitalapplied.com/blog/google-a2a-protocol-agent-to-agent-communication-guide", custody: "personal", ingested_into: Some("dr-estate-dr-1787669880") }, FetchedSource { url: "https://en.wikipedia.org/wiki/Model_Context_Protocol", custody: "personal", ingested_into: Some("dr-estate-dr-1787669880") }, FetchedSource { url: "https://codilime.com/blog/a2a-protocol-explained", custody: "personal", ingested_into: Some("dr-estate-dr-1787669880") }, FetchedSource { url: "https://glama.ai/blog/2024-11-25-model-context-protocol-quickstart", custody: "personal", in