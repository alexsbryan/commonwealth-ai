     "evidence": {
      "pair": [
       {
        "id": "claim-9f2994857e05a569",
        "attributed_to": "Henry Allison | Allison",
        "sections": [
         "sec_0013"
        ],
        "content": "Space and time are 'epistemic conditions'—representations we must apply to objects in order to cognize them as empirical appearances."
       },
       {
        "id": "claim-e8bcd96a6db34fe0",
        "attributed_to": "Henry Allison | Allison",
        "sections": [
         "sec_0013"
        ],
        "content": "Thinking of objects as things in themselves using categories does not constitute cognition because it lacks the epistemic condition of intuition (space/time)."
       },
       {
        "id": "claim-ba3972133688ec47",
        "attributed_to": null,
        "sections": [
         "sec_0016"
        ],
        "content": "Allison's response to the objection that her reading allows for spatially necessary objects begs the question by assuming a standpoint-independent perspective on reality."
       },
       {
        "id": "claim-b735ca70c170d37b",
        "attributed_to": "Langton | Langton (1998)",
        "sections": [
         "sec_0016"
        ],
        "content": "Langton argues that Allison's reading is incompatible with the sense of epistemic loss or cognitive deprivation found in Kant regarding things in themselves."
       }
      ],
      "attributed_right": [
       "claim-9f2994857e05a569",
